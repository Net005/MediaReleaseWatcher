# Copy to .env and replace both passwords and APP_SECRET before starting.
# scripts/configure.py can generate these and optionally import an existing key.
APP_PORT=8317
APP_BIND=127.0.0.1
POSTGRES_DB=media_release_watcher
POSTGRES_USER=media_release_watcher
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional: set here, or enter it in the web Settings. Never commit .env.
MDBLIST_API_KEY=
TZ=Europe/Amsterdam
# Optional public reverse-proxy URL for notification deep links.
PUBLIC_URL=
